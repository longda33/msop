<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 本机音频：Android 13+ 用 READ_MEDIA_AUDIO，12 及以下用 READ_EXTERNAL_STORAGE -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- 后台播放（P2-02） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- ExoPlayer 的 setWakeMode：息屏后不让 CPU 睡下去把播放掐断 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- P5-05：引导用户把 App 加入电池优化白名单（自用不上架，不受 Play 政策限制） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 均衡器需要 attach 到 audio session；部分 ROM 要求声明此权限 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:name=".MsopApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Msop">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Msop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 后台播放服务。exported=true 是为了让系统/车机/手表等外部控制器能连上，
             这也是 Media3 官方推荐配置。
             tools:ignore="Instantiatable"：服务类在 :feature:player，父类 MediaSessionService
             来自该模块的 implementation 依赖，app 模块的 lintVitalRelease 看不到继承链会误报。
             release 包已真机验证服务能正常被系统创建。 -->
        <service
            android:name="com.msop.player.feature.player.PlaybackService"
            android:exported="true"
            android:stopWithTask="false"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- 关闭 WorkManager 的默认初始化，改由 MsopApplication 提供 HiltWorkerFactory。
             不这样做 @HiltWorker 的 Worker 会因找不到工厂而实例化失败。 -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
