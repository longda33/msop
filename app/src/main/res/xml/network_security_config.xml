<?xml version="1.0" encoding="utf-8"?>
<!--
  访问安全基线（P3-06 / 2026-11-16 修订）。

  cleartextTrafficPermitted=true：**允许明文 HTTP**。2026-11-16 用户提供了两台
  `http://` 的音源（含内网 `172.207.160.128:5244`），要求 App 支持 HTTP，因此把
  base-config 放开。这里必须坦白：network security config 是**静态**的，无法按用户
  临时输入的域名动态放行，所以只能全局放开；真正的开关放在应用层——

  * 每条服务器配置带 `allowPlainHttp` 标记，只有用户在保存时对 `http://` 地址
    点过「仍然继续」（二次确认）才会置 true；
  * `OpenListClient.requireConfig()` 与 `WebDavClient.ensureAllowed()` 见到
    `http://` 且标记为 false 时**直接抛异常，不把请求发出去**；
  * 缺省仍然优先 https：地址不带协议时自动补 `https://`。

  也就是说：系统层不再拦明文，拦在代码里，且每个配置各自留痕（见 AGENTS.md D27）。

  user CA：允许用户在系统设置里导入自签证书后连自己的服务器（决策 D8），
  比信任所有证书安全，比替换服务端证书省事。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
