<?xml version="1.0" encoding="utf-8"?>
<!--
  通知栏 / 锁屏小图标（2026-11-16 用户指令：「音符图标换成耳机，和软件图标耳机一样」）。
  形态照桌面图标 msop_icon.png：头梁圆弧 + 两只耳罩 + 三条电平柱，
  但系统状态栏只会按 alpha 渲染单色剪影，所以这里用纯白描边矢量而不是彩色位图。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 头梁 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M4.2,15.2 A7.8,7.8 0 0 1 19.8,15.2"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="2.2" />
    <!-- 左耳罩 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M4.2,15 L4.2,18.6"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="3.4" />
    <!-- 右耳罩 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M19.8,15 L19.8,18.6"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="3.4" />
    <!-- 电平柱：左短 / 中高 / 右中（与桌面图标的三根一致） -->
    <path
        android:fillColor="#00000000"
        android:pathData="M9.6,16.6 L9.6,19.2"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="1.6" />
    <path
        android:fillColor="#00000000"
        android:pathData="M12,14.8 L12,19.2"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="1.6" />
    <path
        android:fillColor="#00000000"
        android:pathData="M14.4,16.2 L14.4,19.2"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="1.6" />
</vector>
